give @s carrot_on_a_stick[custom_name={text:"Netherite Crystal",bold:true,italic:false,color:"dark_gray"},lore=[{text:"Deeper than the fires of the Nether, beneath ",italic:false},{text:"the ancient debris of a world that existed ",italic:false},{text:"before time, lies Netherite. It is the heaviest ",italic:false},{text:"substance in existence, a metal so dense it ",italic:false},{text:"anchors the wielder to the very center of the ",italic:false},{text:"earth. It represents the \"Unbreakable Will.\" ",italic:false},{text:"While Diamond resists, Netherite simply is. It is ",italic:false},{text:"the stone of gravity and consequence; when ",italic:false},{text:"it strikes, it does not just hit—it collapses the ",italic:false},{text:"space around it. To bind with Netherite is to ",italic:false},{text:"become a mountain: unmoving, unyielding, and ",italic:false},{text:"absolutely terrifying to those in your shadow.",italic:false}],rarity=epic,enchantment_glint_override=true,unbreakable={},custom_model_data={floats:[10]},custom_data={gem:"netherite"},tooltip_display={hidden_components:[enchantments]}]