give @s carrot_on_a_stick[custom_name={text:"Quartz Crystal",bold:true,italic:false,color:"white"},lore=[{text:"While most gems grow in the cool dark of ",italic:false},{text:"the Overworld, Quartz is born in the ",italic:false},{text:"screaming fires of the Nether. It is a ",italic:false},{text:"crystal of pure, frantic energy and ",italic:false},{text:"absolute efficiency. It is used in the most ",italic:false},{text:"complex machines because it never tires ",italic:false},{text:"and never slows. It represents the",italic:false},{text:"\"Overclocked\" soul—stripping away all ",italic:false},{text:"emotion and distraction to achieve a state ",italic:false},{text:"of perfect, terrifying productivity. It is",italic:false},{text:"cold logic in a world of fire.",italic:false}],rarity=epic,enchantment_glint_override=true,unbreakable={},custom_model_data={floats:[7]},custom_data={gem:"quartz"},tooltip_display={hidden_components:[enchantments]}]