give @s carrot_on_a_stick[custom_name={text:"Lapis Crystal",bold:true,italic:false,color:"dark_blue"},lore=[{text:"Long ago, the night sky was made of liquid,",italic:false},{text:"and droplets fell into the deepest caves, ",italic:false},{text:"hardening into Lapis Lazuli. This gem is ",italic:false},{text:"the physical manifestation of the Arcane.",italic:false},{text:" It is the ink of the gods, used to write the",italic:false},{text:" laws of magic into the fabric of reality.",italic:false},{text:" Those who carry Lapis find their",italic:false},{text:" thoughts flowing faster, their knowledge",italic:false},{text:" expanding like a rising tide, and their",italic:false},{text:" connection to the mysterious",italic:false},{text:" \"Experience\" of the world sharpened",italic:false},{text:" to a razor's edge.",italic:false}],rarity=epic,enchantment_glint_override=true,unbreakable={},custom_model_data={floats:[4]},custom_data={gem:"lapis"},tooltip_display={hidden_components:[enchantments]}]