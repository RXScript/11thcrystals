give @s carrot_on_a_stick[custom_name={text:"Redstone Crystal",bold:true,italic:false,color:"red"},lore=[{text:"Redstone is the nervous system of the world. ",italic:false},{text:"It is not a static stone, but a trapped storm of ",italic:false},{text:"kinetic energy, constantly seeking a path to ",italic:false},{text:"travel. It represents the \"Spark of Life\" that ",italic:false},{text:"turns a pile of stones into a titan. Ancient ",italic:false},{text:"engineers believed that Redstone was the ",italic:false},{text:"blood of a sleeping giant that flows beneath ",italic:false},{text:"the bedrock. To carry this crystal is to feel ",italic:false},{text:"your pulse sync with the rhythm of the ",italic:false},{text:"world’s machinery—granting you the power ",italic:false},{text:"to energize your allies and accelerate your ",italic:false},{text:"own soul until the world around you seems to ",italic:false},{text:"stand still.",italic:false}],rarity=epic,enchantment_glint_override=true,unbreakable={},custom_model_data={floats:[11]},custom_data={gem:"redstone"},tooltip_display={hidden_components:[enchantments]}]