give @s carrot_on_a_stick[custom_name={text:"Prismarine Crystal",bold:true,italic:false,color:"dark_aqua"},lore=[{text:"Prismarine is not a stone, but a living, ",italic:false},{text:"breathing calcification of the deep ocean. ",italic:false},{text:"It shifts colors like the skin of a kraken ",italic:false},{text:"and carries the crushing pressure of the ",italic:false},{text:"midnight zone. It is the armor of the ",italic:false},{text:"Guardians, designed to protect the ",italic:false},{text:"treasures of sunken empires. To hold ",italic:false},{text:"Prismarine is to feel the weight of the sea ",italic:false},{text:"and the cold, relentless sting of the salt ",italic:false},{text:"spray. The ocean never forgets a debt, ",italic:false},{text:"and Prismarine is the collector.",italic:false}],rarity=epic,enchantment_glint_override=true,unbreakable={},custom_model_data={floats:[8]},custom_data={gem:"prismarine"},tooltip_display={hidden_components:[enchantments]}]