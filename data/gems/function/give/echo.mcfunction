give @s carrot_on_a_stick[custom_name={text:"Echo Crystal",bold:true,italic:false,color:"#07075f"},lore=[{text:"Deep in the rotting heart of the Ancient ",italic:false},{text:"Cities, where the Sculk consumes the ",italic:false},{text:"bones of the forgotten, the Echo Shards ",italic:false},{text:"are found. They are fragments of a ",italic:false},{text:"scream that was never finished—a sound ",italic:false},{text:"so loud it became solid. They are made of ",italic:false},{text:"pure darkness and the absence of light. ",italic:false},{text:"To use an Echo Shard is to step between ",italic:false},{text:"the seconds of time and walk through the",italic:false},{text:"void where even the Warden’s ears cannot ",italic:false},{text:"find you. It is the stone of things that ",italic:false},{text:"should have stayed buried.",italic:false}],rarity=epic,enchantment_glint_override=true,unbreakable={},custom_model_data={floats:[9]},custom_data={gem:"echo_shard"},tooltip_display={hidden_components:[enchantments]}]