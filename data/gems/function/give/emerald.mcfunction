give @s carrot_on_a_stick[custom_name={text:"Emerald Crystal",bold:true,italic:false,color:"green"},lore=[{text:"Emeralds are the eyes of the earth,",italic:false},{text:"watching every transaction, every ",italic:false},{text:"bargain, and every betrayal. They are ",italic:false},{text:"deeply tied to the pulse of civilization and ",italic:false},{text:"the flow of the \"Living Green.\" Ancient ",italic:false},{text:"kings believed that by holding an Emerald, ",italic:false},{text:"they could hear the whispers of their ",italic:false},{text:"subjects and the rustle of growing wheat. ",italic:false},{text:"It is a stone of manipulation; it commands",italic:false},{text:"life because life, like everything else, has ",italic:false},{text:"a price that can be paid.",italic:false}],rarity=epic,enchantment_glint_override=true,unbreakable={},custom_model_data={floats:[2]},custom_data={gem:"emerald"},tooltip_display={hidden_components:[enchantments]}]